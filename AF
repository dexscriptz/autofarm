local function getCharacterParts()
    if not player or not player.Character then
        return nil, nil, nil
    end
    
    local char = player.Character
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    return char, hum, root
end

local function updateCollectedDisplay()
    collectedLabel.Text = "Items Collected: " .. itemsCollected
end

local lastItemCollection = 0
local function incrementItemsCollected()
    local currentTime = tick()
    if currentTime - lastItemCollection > 0.5 then
        itemsCollected = itemsCollected + 1
        updateCollectedDisplay()
        lastItemCollection = currentTime
        
        local originalSize = collectedLabel.TextSize
        local scaleUp = createTween(collectedLabel, {TextSize = originalSize + 3}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        local scaleDown = createTween(collectedLabel, {TextSize = originalSize}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        
        scaleUp:Play()
        scaleUp.Completed:Connect(function()
            scaleDown:Play()
        end)
    end
end

local function findCollectibleContainer()
    local function searchInModel(model)
        if model and model.Name == ContainerName then
            return model
        end
        
        if model then
            for _, child in ipairs(model:GetChildren()) do
                if child:IsA("Model") or child:IsA("Folder") then
                    local result = searchInModel(child)
                    if result then
                        return result
                    end
                end
            end
        end
        return nil
    end
    
    return searchInModel(Workspace)
end

local function continuousContainerSearch()
    while true do
        if not collectibleContainer or not collectibleContainer.Parent then
            local success, result = pcall(function()
                return findCollectibleContainer()
            end)
            
            if success then
                collectibleContainer = result
                containerSearchAttempts = containerSearchAttempts + 1
                
                if collectibleContainer then
                    if not isMinimized then
                        infoLabel.Text = ContainerName .. " found!"
                    end
                    containerSearchAttempts = 0
                else
                    if autoFarmEnabled and not isMinimized then
                        infoLabel.Text = "Searching for " .. ContainerName .. "... (" .. containerSearchAttempts .. ")"
                    end
                end
            else
                warn("Error searching for " .. ContainerName .. ": " .. tostring(result))
                if not isMinimized then
                    infoLabel.Text = "Search error, retrying..."
                end
            end
        else
            local success, exists = pcall(function()
                return collectibleContainer.Parent ~= nil
            end)
            
            if not success or not exists then
                collectibleContainer = nil
                if not isMinimized then
                    infoLabel.Text = ContainerName .. " lost, searching..."
                end
            end
        end
        
        wait(3)
    end
end

local function findCollectibleParts(container)
    if not container then return {} end
    
    local parts = {}
    
    local function searchForParts(model)
        if model:IsA("BasePart") then
            for _, collectibleName in ipairs(CollectibleNames) do
                if model.Name == collectibleName then
        
                    local hasVisibleVisual = false
                    for _, visualName in ipairs(VisualPartNames) do
                        for _, child in ipairs(model:GetDescendants()) do
                            if child and child.Name == visualName and child:IsA("BasePart") then
                                if child.Transparency < 1 then
                                    hasVisibleVisual = true
                                    break
                                end
                            end
                        end
                        if hasVisibleVisual then break end
                    end
                    
                    if hasVisibleVisual then
                        table.insert(parts, model)
                    end
                    break
                end
            end
        end
        
        if model then
            for _, child in ipairs(model:GetChildren()) do
                searchForParts(child)
            end
        end
    end
    
    searchForParts(container)
    return parts
end

local function hasVisibleVisual(collectiblePart)
    if not collectiblePart or not collectiblePart.Parent then return false end
    
    for _, visualName in ipairs(VisualPartNames) do
        for _, child in ipairs(collectiblePart:GetDescendants()) do
            if child and child.Name == visualName and child:IsA("BasePart") then
                if child.Transparency < 1 then
                    return true
                end
            end
        end
    end
    return false
end


local function findNearestCollectible()
    if not collectibleContainer then
        return nil
    end
    
    local char, hum, root = getCharacterParts()
    if not char or not root then return nil end
    
    collectibleParts = findCollectibleParts(collectibleContainer)
    
    if #collectibleParts == 0 then
        return nil
    end
    
    local nearestPart = nil
    local nearestDistance = 500
    
    for _, part in ipairs(collectibleParts) do
        if part and part.Parent and hasVisibleVisual(part) then
            local distance = (root.Position - part.Position).Magnitude
            if distance <= nearestDistance then
                nearestDistance = distance
                nearestPart = part
            end
        end
    end
    
    return nearestPart, nearestDistance
end

local function enableNoclip()
    if connection then
        connection:Disconnect()
    end
    
    connection = RunService.Stepped:Connect(function()
        if autoFarmEnabled then
            local char, _, _ = getCharacterParts()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end

local function disableNoclip()
    if connection then
        connection:Disconnect()
        connection = nil
    end
end

local function flyToPosition(targetPosition)
    local char, hum, root = getCharacterParts()
    if not char or not root then return false end
    
    local distance = (root.Position - targetPosition).Magnitude
    local travelTime = math.max(1, distance / 50)
    
    local tweenInfo = TweenInfo.new(
        travelTime,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    
    local tween = TweenService:Create(root, tweenInfo, {Position = targetPosition})
    tween:Play()
    
    local startTime = tick()
    while tick() - startTime < travelTime + 2 do
        if not autoFarmEnabled then
            tween:Cancel()
            return false
        end
        
        local currentChar, currentHum, currentRoot = getCharacterParts()
        if not currentChar or not currentRoot or (currentHum and currentHum.Health <= 0) then
            tween:Cancel()
            return false
        end
        
        if tween.PlaybackState == Enum.PlaybackState.Completed then
            break
        end
        
        wait(0.1)
    end
    
    return true
end

local function updateUI()
    if autoFarmEnabled then
        toggleButton.Text = "STOP FARMING"
        statusLabel.Text = "Status: Farming"
        statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        animateButton(toggleButton, Color3.fromRGB(220, 80, 80), 0.3)
    else
        toggleButton.Text = "START FARMING"
        statusLabel.Text = "Status: Ready"
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
        animateButton(toggleButton, Color3.fromRGB(60, 180, 80), 0.3)
    end
end

local function farmingProcess()
    while autoFarmEnabled do
        local char, hum, root = getCharacterParts()
        
        if not char or not hum or hum.Health <= 0 then
            if not isMinimized then
                infoLabel.Text = "Waiting for valid character..."
            end
            wait(2)
            continue
        end
        
        if not collectibleContainer then
            if not isMinimized then
                infoLabel.Text = "Searching for " .. ContainerName .. "..."
            end
            wait(2)
            continue
        end
        
        collectibleParts = findCollectibleParts(collectibleContainer)
        local nearestCollectible, distance = findNearestCollectible()
        
        if nearestCollectible then
            currentTarget = nearestCollectible
            if not isMinimized then
                infoLabel.Text = "Moving to Candy (" .. math.floor(distance) .. " studs)"
            end
            
            local flySuccess = flyToPosition(nearestCollectible.Position + Vector3.new(0, 3, 0))
            
            if flySuccess then
                local startTime = tick()
                local itemWasCollected = false
                
                while tick() - startTime < stayDuration and autoFarmEnabled do
                    local currentChar, currentHum, currentRoot = getCharacterParts()
                    if not currentChar or not currentHum or currentHum.Health <= 0 then
                        break
                    end
                    
                    if not hasVisibleVisual(nearestCollectible) then
                        itemWasCollected = true
                        incrementItemsCollected()
                        if not isMinimized then
                            infoLabel.Text = "Candies collected! Finding next..."
                        end
                        break
                    end
                    wait(0.1)
                end
                
                if not itemWasCollected and not hasVisibleVisual(nearestCollectible) then
                    incrementItemsCollected()
                end
            end
        else
            if not isMinimized then
                infoLabel.Text = "Waiting for round to end"
            end
            wait(1)
        end
        
        wait(0.1)
    end
end

local function startFarming()
    if autoFarmEnabled then return end
    
    autoFarmEnabled = true
    updateUI()
    enableNoclip()
    
    local newDuration = tonumber(durationBox.Text)
    if newDuration and newDuration > 0 then
        stayDuration = newDuration
    else
        durationBox.Text = tostring(stayDuration)
    end
    
    farmingLoop = coroutine.create(farmingProcess)
    coroutine.resume(farmingLoop)
    
    if not isMinimized then
        infoLabel.Text = "Farming started! Searching for Candies..."
    end
end

local function stopFarming()
    if not autoFarmEnabled then return end
    
    autoFarmEnabled = false
    updateUI()
    disableNoclip()
    
    if farmingLoop then
        farmingLoop = nil
    end
    
    if not isMinimized then
        infoLabel.Text = "Farming stopped. Ready to start."
    end
end

local function initializeScript()
    playEntranceAnimation()
    
    toggleButton.MouseButton1Click:Connect(function()
        if autoFarmEnabled then
            stopFarming()
        else
            startFarming()
        end
    end)

    minimizeButton.MouseButton1Click:Connect(toggleMinimize)

    durationBox.FocusLost:Connect(function()
        local newDuration = tonumber(durationBox.Text)
        if newDuration and newDuration > 0 then
            stayDuration = newDuration
        else
            durationBox.Text = tostring(stayDuration)
        end
    end)

    player.CharacterAdded:Connect(function(newCharacter)
        if autoFarmEnabled then
            wait(2)
            enableNoclip()
            if not isMinimized then
                infoLabel.Text = "Player respawned, continuing..."
            end
        end
    end)

    spawn(function()
        pcall(continuousContainerSearch)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.F then
            if autoFarmEnabled then
                stopFarming()
            else
                startFarming()
            end
        end
    end)

    game:GetService("Players").PlayerRemoving:Connect(function(leavingPlayer)
        if leavingPlayer == player then
            stopFarming()
            if screenGui then
                screenGui:Destroy()
            end
        end
    end)
end

initializeScript()

