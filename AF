local function createTween(object, properties, duration, easingStyle, easingDirection)
    local safeProperties = {}
    
    for property, value in pairs(properties) do
        local success = pcall(function()
            local current = object[property]
            object[property] = value
            object[property] = current
        end)
        
        if success then
            safeProperties[property] = value
        end
    end
    
    if next(safeProperties) == nil then
        return { Play = function() end, Completed = { Connect = function() end } }
    end
    
    local tweenInfo = TweenInfo.new(duration, easingStyle or Enum.EasingStyle.Quad, easingDirection or Enum.EasingDirection.Out)
    local tween = TweenService:Create(object, tweenInfo, safeProperties)
    return tween
end

