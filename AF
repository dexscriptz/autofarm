    end
end

-- Button animation function
local function animateButton(button, targetColor, duration)
    local success = pcall(function()
        local current = button.BackgroundColor3
        button.BackgroundColor3 = targetColor
        button.BackgroundColor3 = current
    end)
    
    if success then
        local tween = createTween(button, {BackgroundColor3 = targetColor}, duration)
        tween:Play()
    else
        button.BackgroundColor3 = targetColor
    end
end

-- Function to safely get character parts
local function getCharacterParts()
    if not player or not player.Character then
        return nil, nil, nil
    end
    
    local char = player.Character
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    return char, hum, root
end

-- Function to update collected coins display
local function updateCollectedDisplay()
    collectedLabel.Text = "Coins Collected: " .. coinsCollected
end

-- Function to safely increment coins collected
local lastCoinCollection = 0
local function incrementCoinsCollected()
    local currentTime = tick()
    if currentTime - lastCoinCollection > 0.5 then
        coinsCollected = coinsCollected + 1
        updateCollectedDisplay()
        lastCoinCollection = currentTime
        
        local originalSize = collectedLabel.TextSize
        local scaleUp = createTween(collectedLabel, {TextSize = originalSize + 3}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        local scaleDown = createTween(collectedLabel, {TextSize = originalSize}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        
        scaleUp:Play()
        scaleUp.Completed:Connect(function()
            scaleDown:Play()
        end)
    end
end

-- Function to find CoinContainer in workspace
local function findCoinContainer()
    local function searchInModel(model)
        if model and model.Name == "CoinContainer" then
            return model
        end
        
        if model then
            for _, child in ipairs(model:GetChildren()) do
                if child:IsA("Model") or child:IsA("Folder") then
                    local result = searchInModel(child)
                    if result then
                        return result
                    end
                end
            end
        end
        return nil
    end
    
    return searchInModel(Workspace)
end

-- Function to continuously search for CoinContainer
local function continuousCoinContainerSearch()
    while true do
        if not coinContainer or not coinContainer.Parent then
            local success, result = pcall(function()
                return findCoinContainer()
            end)
            
            if success then
                coinContainer = result
                coinContainerSearchAttempts = coinContainerSearchAttempts + 1
                
                if coinContainer then
                    if not isMinimized then
                        infoLabel.Text = "CoinContainer found!"
                    end
                    coinContainerSearchAttempts = 0
                else
                    if autoFarmEnabled and not isMinimized then
                        infoLabel.Text = "Searching for coins... (" .. coinContainerSearchAttempts .. ")"
                    end
                end
            else
                warn("Error searching for CoinContainer: " .. tostring(result))
                if not isMinimized then
                    infoLabel.Text = "Search error, retrying..."
                end
            end
        else
            local success, exists = pcall(function()
                return coinContainer.Parent ~= nil
            end)
            
            if not success or not exists then
                coinContainer = nil
                if not isMinimized then
                    infoLabel.Text = "CoinContainer lost, searching..."
                end
            end
        end
        
        wait(3)
    end
end

-- Function to find all Coin_Server parts and check their CoinVisual transparency
local function findCoinParts(container)
    if not container then return {} end
    
    local parts = {}
    
    local function searchForParts(model)
        if model and model.Name == "Coin_Server" and model:IsA("BasePart") then
            local hasVisibleCoin = false
            for _, child in ipairs(model:GetDescendants()) do
                if child and child.Name == "CoinVisual" and child:IsA("BasePart") then
                    if child.Transparency < 1 then
                        hasVisibleCoin = true
                        break
                    end
                end
            end
            
            if hasVisibleCoin then
                table.insert(parts, model)
            end
        end
        
        if model then
            for _, child in ipairs(model:GetChildren()) do
                searchForParts(child)
            end
        end
    end
    
    searchForParts(container)
    return parts
end

-- Function to check if a coin part has any visible CoinVisual
local function hasVisibleCoinVisual(coinPart)
    if not coinPart or not coinPart.Parent then return false end
    
    for _, child in ipairs(coinPart:GetDescendants()) do
        if child and child.Name == "CoinVisual" and child:IsA("BasePart") then
            if child.Transparency < 1 then
                return true
            end
        end
    end
    return false
end

-- Function to find nearest visible coin part
local function findNearestCoin()
    if not coinContainer then
        return nil
    end
    
    local char, hum, root = getCharacterParts()
    if not char or not root then return nil end
    
    coinParts = findCoinParts(coinContainer)
    
    if #coinParts == 0 then
        return nil
    end
    
    local nearestPart = nil
    local nearestDistance = 500
    
    for _, part in ipairs(coinParts) do
        if part and part.Parent and hasVisibleCoinVisual(part) then
            local distance = (root.Position - part.Position).Magnitude
            if distance <= nearestDistance then
                nearestDistance = distance
                nearestPart = part
            end
        end
    end
    
    return nearestPart, nearestDistance
end

-- Function to enable noclip
local function enableNoclip()
    if connection then
        connection:Disconnect()
    end
    
    connection = RunService.Stepped:Connect(function()
        if autoFarmEnabled then
            local char, _, _ = getCharacterParts()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end

-- Function to disable noclip
local function disableNoclip()
    if connection then
        connection:Disconnect()
        connection = nil
    end
end

-- Function to fly to position
local function flyToPosition(targetPosition)
    local char, hum, root = getCharacterParts()
    if not char or not root then return false end
    
    local distance = (root.Position - targetPosition).Magnitude
    local travelTime = math.max(1, distance / 50)
    
    local tweenInfo = TweenInfo.new(
        travelTime,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    
    local tween = TweenService:Create(root, tweenInfo, {Position = targetPosition})
    tween:Play()
    
    local startTime = tick()
    while tick() - startTime < travelTime + 2 do
        if not autoFarmEnabled then
            tween:Cancel()
            return false
        end
        
        local currentChar, currentHum, currentRoot = getCharacterParts()
        if not currentChar or not currentRoot or (currentHum and currentHum.Health <= 0) then
            tween:Cancel()
            return false
        end
        
        if tween.PlaybackState == Enum.PlaybackState.Completed then
            break
        end
        
        wait(0.1)
    end
    
    return true
end

-- Function to update UI
local function updateUI()
    if autoFarmEnabled then
        toggleButton.Text = "STOP FARMING"
        statusLabel.Text = "Status: Farming"
        statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        animateButton(toggleButton, Color3.fromRGB(220, 80, 80), 0.3)
    else
        toggleButton.Text = "START FARMING"
        statusLabel.Text = "Status: Ready"
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
        animateButton(toggleButton, Color3.fromRGB(60, 180, 80), 0.3)
    end
end

-- Main farming process
local function farmingProcess()
    while autoFarmEnabled do
        local char, hum, root = getCharacterParts()
        
        if not char or not hum or hum.Health <= 0 then
            if not isMinimized then
                infoLabel.Text = "Waiting for valid character..."
            end
            wait(2)
            continue
        end
        
        if not coinContainer then
            if not isMinimized then
                infoLabel.Text = "Searching for CoinContainer..."
            end
            wait(2)
            continue
        end
        
        coinParts = findCoinParts(coinContainer)
        local nearestCoin, distance = findNearestCoin()
        
        if nearestCoin then
            currentTarget = nearestCoin
            if not isMinimized then
                infoLabel.Text = "Flying to coin (" .. math.floor(distance) .. " studs)"
            end
            
            local flySuccess = flyToPosition(nearestCoin.Position + Vector3.new(0, 3, 0))
            
            if flySuccess then
                local startTime = tick()
                local coinWasCollected = false
                
                while tick() - startTime < stayDuration and autoFarmEnabled do
                    local currentChar, currentHum, currentRoot = getCharacterParts()
                    if not currentChar or not currentHum or currentHum.Health <= 0 then
                        break
                    end
                    
                    if not hasVisibleCoinVisual(nearestCoin) then
                        coinWasCollected = true
                        incrementCoinsCollected()
                        if not isMinimized then
                            infoLabel.Text = "Coin collected! Finding next..."
                        end
                        break
                    end
                    wait(0.1)
                end
                
                if not coinWasCollected and not hasVisibleCoinVisual(nearestCoin) then
                    incrementCoinsCollected()
                end
            end
        else
            if not isMinimized then
                infoLabel.Text = "No visible coins in range (500 studs)"
            end
            wait(1)
        end
        
        wait(0.1)
    end
end

-- Function to start farming
local function startFarming()
    if autoFarmEnabled then return end
    
    autoFarmEnabled = true
    updateUI()
    enableNoclip()
    
    local newDuration = tonumber(durationBox.Text)
    if newDuration and newDuration > 0 then
        stayDuration = newDuration
    else
        durationBox.Text = tostring(stayDuration)
    end
    
    farmingLoop = coroutine.create(farmingProcess)
    coroutine.resume(farmingLoop)
    
    if not isMinimized then
        infoLabel.Text = "Farming started! Searching for coins..."
    end
end

-- Function to stop farming
local function stopFarming()
    if not autoFarmEnabled then return end
    
    autoFarmEnabled = false
    updateUI()
    disableNoclip()
    
    if farmingLoop then
        farmingLoop = nil
    end
    
    if not isMinimized then
        infoLabel.Text = "Farming stopped. Ready to start."
    end
end

-- Connect events after UI is created
local function initializeScript()
    -- Play entrance animation
    playEntranceAnimation()
    
    -- Connect events
    toggleButton.MouseButton1Click:Connect(function()
        if autoFarmEnabled then
            stopFarming()
        else
            startFarming()
        end
    end)

    minimizeButton.MouseButton1Click:Connect(toggleMinimize)

    durationBox.FocusLost:Connect(function()
        local newDuration = tonumber(durationBox.Text)
        if newDuration and newDuration > 0 then
            stayDuration = newDuration
        else
            durationBox.Text = tostring(stayDuration)
        end
    end)

    -- Auto-detect when character respawns
    player.CharacterAdded:Connect(function(newCharacter)
        if autoFarmEnabled then
            wait(2)
            enableNoclip()
            if not isMinimized then
                infoLabel.Text = "Player respawned, continuing..."
            end
        end
    end)

    -- Start continuous coin container search
    spawn(function()
        pcall(continuousCoinContainerSearch)
    end)

    -- Keybind to toggle (F key)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.F then
            if autoFarmEnabled then
                stopFarming()
            else
                startFarming()
            end
        end
    end)

    -- Cleanup when player leaves
    game:GetService("Players").PlayerRemoving:Connect(function(leavingPlayer)
        if leavingPlayer == player then
            stopFarming()
            if screenGui then
                screenGui:Destroy()
            end
        end
    end)
end

-- Start the script
initializeScript()

print("Auto Coin Farm Script Loaded!")
